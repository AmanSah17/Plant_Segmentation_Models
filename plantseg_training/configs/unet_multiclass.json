{
  "experiment_name": "plantseg-multiclass-segmentation",
  "run_name": "unet-multiclass-256",
  "seed": 42,
  "dataset": {
    "root_dir": "Data_exploration/data/archive/plantsegv2",
    "metadata_csv": "Data_exploration/data/archive/plantsegv2/Metadatav2.csv",
    "processed_mask_dir": "plantseg_training/processed/multiclass/masks",
    "class_weights_path": "plantseg_training/processed/multiclass/reports/class_weights.json",
    "task": "multiclass_segmentation",
    "image_size": 256,
    "num_workers": 4,
    "pin_memory": true
  },
  "model": {
    "name": "unet",
    "in_channels": 3,
    "num_classes": 115,
    "features": [64, 128, 256, 512],
    "dropout": 0.1,
    "loss": {
      "class_weights": "auto",
      "ce_weight": 1.0,
      "dice_weight": 1.0,
      "focal_weight": 0.5,
      "focal_gamma": 2.0,
      "dice_smooth": 1.0,
      "include_background_in_dice": false
    }
  },
  "training": {
    "output_dir": "plantseg_training/outputs/unet_multiclass",
    "mlflow_tracking_uri": "plantseg_training/outputs/mlruns",
    "create_run_subdir": true,
    "require_cuda": true,
    "num_train_epochs": 100,
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "warmup_ratio": 0.01,
    "max_grad_norm": 1.0,
    "eval_accumulation_steps": 10,
    "cudnn_benchmark": true,
    "logging_steps": 50,
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "save_total_limit": 3,
    "metric_for_best_model": "eval_mean_dice",
    "greater_is_better": true,
    "class_balanced_sampling": true,
    "report_to": ["tensorboard"],
    "disable_tqdm": false,
    "fp16": false,
    "threshold": 0.5
  }
}
